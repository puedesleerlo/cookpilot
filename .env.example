# Kitchen Compiler - local environment.
#
# Copy to .env and fill in. .env is gitignored and must never be committed.
# In Cloud Run these come from Secret Manager, mounted by PINNED VERSION, never "latest".
#
# Generated by scripts/gen-secret-artifacts.mjs from apps/api/src/config/secrets.ts.
# Edit the inventory, not this file.

# --- The model provider needs no secret. ---
# Vertex AI authenticates through the Cloud Run service account (Application Default
# Credentials). Locally, run: gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=
VERTEX_LOCATION=global

# --- Required ---
# Postgres connection string, including credentials.
# Source: Cloud SQL or Neon connection details
# Read by: api, worker
DATABASE_URL=

# Redis connection string for cache, queue and pub/sub.
# Source: Memorystore or Upstash connection details
# Read by: api, worker
REDIS_URL=

# Signing key for anonymous device tokens.
# Source: openssl rand -base64 48
# Read by: api
JWT_SECRET=

# --- Optional ---
# Brave Search, for external recipe discovery. Discovery degrades without it.
# Source: Brave Search API dashboard
# Read by: api
BRAVE_API_KEY=

# Voice I/O. Requires convai_write. Voice degrades to text without it.
# Source: ElevenLabs dashboard, with convai_write enabled
# Read by: api
ELEVENLABS_API_KEY=

# Optional idea source only. Never persisted to the corpus; 1 hour TTL.
# Source: RapidAPI, optional
# Read by: api
SPOONACULAR_API_KEY=

# Server-side error reporting. The client DSN is public and lives elsewhere.
# Source: Sentry project settings
# Read by: api, worker
SENTRY_DSN_SERVER=

# --- Public client config. Safe to ship in the bundle. ---
VITE_API_URL=http://localhost:8080
VITE_SENTRY_DSN_CLIENT=
