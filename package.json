{
  "name": "kitchen-compiler",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.7.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @kitchen/web dev",
    "build": "pnpm -r --sequential build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -b --force --pretty",
    "check": "pnpm scan:secrets && pnpm lint && pnpm typecheck && pnpm test",
    "packs:build": "node scripts/build-seed-packs.mjs && node scripts/build-registry-index.mjs",
    "design:build": "node scripts/build-design-canvas.mjs",
    "scan:bundle": "node scripts/scan-bundle.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "secrets:gen": "node scripts/gen-secret-artifacts.mjs",
    "deploy:web": "pnpm --filter @kitchen/web build && node scripts/deploy-hosting.mjs",
    "deploy:web:dry": "node scripts/deploy-hosting.mjs --dry-run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
