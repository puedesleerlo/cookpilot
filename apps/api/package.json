{
  "name": "@kitchen/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --experimental-strip-types src/index.ts",
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit false",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:generate": "drizzle-kit generate",
    "seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/websocket": "^11.3.0",
    "@kitchen/contracts": "workspace:*",
    "@kitchen/domain": "workspace:*",
    "@kitchen/recipes": "workspace:*",
    "@kitchen/scheduler": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.4",
    "jose": "^6.2.12",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.9",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.13"
  }
}
